# Next.js builds these values into the browser bundle, so never put a secret here.
NEXT_PUBLIC_API_BASE_URL=https://app-cip-dab-tivra01.azurewebsites.net/api

# Sent as X-MS-API-ROLE: excom, ops, fin, client or admin. Only excom can read everything
# on the Home and estate pages. Other roles see a permission notice on restricted data.
NEXT_PUBLIC_API_ROLE=excom
